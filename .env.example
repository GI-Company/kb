# Groq API key — used server-side only by api/chat.ts, never exposed to the client.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Any Groq-hosted chat model id. Kept configurable since Groq's catalog changes.
# e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen/qwen3-32b, openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile

# Optional — per-IP rate limits (requests/minute). Both have defaults
# (chat 20, exec 30) if unset; only set these to override. See lib/rateLimit.ts —
# this is in-memory/per-instance today, not distributed across every
# concurrent Vercel invocation.
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_EXEC_PER_MIN=30

# --- Not read by any code yet — placeholders for the planned Supabase
# migration (see supabase/schema.sql and ARCHITECTURE.md's "Cuts" section).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
