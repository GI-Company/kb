# Groq API key — used server-side only by api/chat.ts, never exposed to the client.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional override — forces every agent persona onto one Groq model
# instead of each persona's own routing (see lib/agents.ts's rationale,
# picked from the account's actual available-models/rate-limit table).
# Leave unset to use per-persona routing.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional — per-IP rate limits (requests/minute). Both have defaults
# (chat 20, exec 30) if unset; only set these to override. See lib/rateLimit.ts —
# this is in-memory/per-instance today, not distributed across every
# concurrent Vercel invocation.
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_EXEC_PER_MIN=30

# Supabase — enables real accounts + Postgres-backed chat history
# (lib/auth.ts, lib/chatStore.ts). Leave both unset to stay in guest-only/
# localStorage mode; nothing else breaks without them. VITE_ prefix is
# required — this is a Vite app, so only VITE_-prefixed vars reach client
# code, unlike api/*.ts's plain process.env.X (those run server-side).
# The anon key is safe to expose client-side by design (see
# supabase/schema.sql's RLS policies, which are what actually enforce
# access) — no service-role key is used anywhere in this app.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
