# Groq API key — used server-side only by api/chat.ts, never exposed to the client.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Any Groq-hosted chat model id. Kept configurable since Groq's catalog changes.
# e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen/qwen3-32b, openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile
