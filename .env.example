# Groq API key — used server-side only by api/chat.ts, never exposed to the client.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional override — forces every agent persona onto one Groq model
# instead of each persona's own routing (see lib/agents.ts's rationale,
# picked from the account's actual available-models/rate-limit table).
# Leave unset to use per-persona routing.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional — per-IP rate limits (requests/minute). Both have defaults
# (chat 20, exec 30) if unset; only set these to override. See lib/rateLimit.ts —
# this is in-memory/per-instance today, not distributed across every
# concurrent Vercel invocation.
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_EXEC_PER_MIN=30

# Supabase — enables real accounts + Postgres-backed chat history/VFS/local
# models (lib/auth.ts, lib/chatStore.ts, lib/vfs.ts, lib/localModel.ts).
# Leave both unset to stay in guest-only/localStorage+IndexedDB mode;
# nothing else breaks without them. VITE_ prefix is required — this is a
# Vite app, so only VITE_-prefixed vars reach client code, unlike api/*.ts's
# plain process.env.X (those run server-side). The anon key is safe to
# expose client-side by design (see supabase/schema.sql's RLS policies,
# which are what actually enforce access).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Supabase service-role (secret) key — server-side only, NEVER VITE_-prefixed
# and never sent to the browser. Only used by api/guest-usage.ts (via
# lib/supabaseAdmin.ts) to read/write the guest_usage table, which has no
# RLS policy at all since anonymous guests have no auth.uid() to scope to.
# Get it from Supabase -> Project Settings -> API -> "service_role" secret.
# Leave unset and the 15-min/day guest quota simply fails open (unlimited).
# SUPABASE_SERVICE_ROLE_KEY=

# PostHog — product analytics (lib/analytics.ts). Leave unset to disable;
# nothing else depends on it. Use the PROJECT api_token (starts phc_,
# PostHog -> Project Settings -> "Project API Key"), never a personal API
# key (starts phx_, from Settings -> Personal API Keys) — personal keys
# grant broad account/management access and must never reach the browser
# bundle. If you only have a personal key, look up the project token once
# via `curl -H "Authorization: Bearer phx_xxx" https://us.posthog.com/api/projects/`
# rather than shipping the personal key itself.
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
